use serde::{Deserialize, Serialize};
use uuid::Uuid;
use chrono::{DateTime, Utc};
use sqlx::FromRow;

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct User {
    pub id: Uuid,
    pub empresa_id: Uuid,
    pub nome: String,
    pub cpf: String,
    pub telefone: String,
    pub email: String,
    pub senha: String, // Renomeei de "password" para "senha" para alinhar com o SQL
    pub categoria: String,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
}

